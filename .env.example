# ── RAG App — Environment Variables ─────────────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env  (Windows)
#
# For backend local dev, see backend/.env.example
# ---------------------------------------------------------------------------

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Override the default OpenAI model (default: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# (Optional) Custom base URL, e.g. for Azure OpenAI or local mock
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1

# (Optional) Override prompt file in rag_pipeline/prompts/
# RAG_PROMPT_FILE=v2.txt

# ── HuggingFace ──────────────────────────────────────────────────────────────
# (Optional) Only needed if using gated / restricted HuggingFace models.
# The default embedding and reranker models work without a token.
HF_TOKEN=

# ── CORS (Production only) ───────────────────────────────────────────────────
# If you're deploying to a real server with a domain, add it here.
# Comma-separated list. Example: https://myapp.example.com
EXTRA_CORS_ORIGINS=
