# ── Backend Environment Variables ──
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Docker-based usage, see ../.env.example at the project root.
# ---------------------------------------------------------------------------

# ── HuggingFace ──
# (Optional) Token for HuggingFace Hub access if using restricted models
HF_TOKEN=your_token_here

# ── OpenAI ──
OPENAI_API_KEY=your_openai_api_key_here
# (Optional) Override the default model
# OPENAI_MODEL=gpt-4.1-mini

# ── Prompt ──
# (Optional) Override the default prompt file in rag_pipeline/prompts/
# RAG_PROMPT_FILE=v2.txt

# ── API ──
# Any other backend environment variables can go here
