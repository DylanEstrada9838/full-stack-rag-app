# ── Backend Environment Variables ──
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Docker-based usage, see ../.env.example at the project root.
# ---------------------------------------------------------------------------

# ── HuggingFace ──
# (Optional) Token for HuggingFace Hub access if using restricted models
HF_TOKEN=your_token_here

# ── Groq ──
# Get your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# (Optional) Override the default model. See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

# ── API ──
# Any other backend environment variables can go here
